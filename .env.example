# ---- LLM provider ----------------------------------------------------------
# Default provider is Anthropic Claude. Set your key to enable real generation.
# Without a key the app falls back to the "echo" provider (useful for CI/tests).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Most capable model by default; swap to claude-haiku-4-5 to cut cost.
LLM_MODEL=claude-opus-4-8
LLM_EFFORT=medium
LLM_MAX_TOKENS=1024

# ---- Embeddings ------------------------------------------------------------
# Open model, no per-call cost. Set EMBEDDINGS_PROVIDER=hash for an offline,
# dependency-free fallback (used automatically in CI).
EMBEDDINGS_PROVIDER=sentence-transformers
EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5

# ---- Vector store ----------------------------------------------------------
# pgvector (Postgres) in production; "memory" (numpy) for local dev / CI.
VECTOR_STORE=pgvector
# Postgres credentials used by docker-compose (db + api). The "rag" defaults
# are for local development only; set a strong, URL-safe password for anything
# shared. Note: Postgres keeps the password it was first initialised with, so
# changing it later needs `docker compose down -v` (wipes the index) or ALTER USER.
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
# Used outside Docker (compose builds its own DATABASE_URL from the values above).
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# ---- Retrieval -------------------------------------------------------------
TOP_K=5
CHUNK_TOKENS=600
CHUNK_OVERLAP=80
MIN_RETRIEVAL_SCORE=0.25

# ---- Guardrails ------------------------------------------------------------
INJECTION_SCORE_THRESHOLD=0.8
GROUNDING_MIN_SUPPORT=0.35

# ---- API -------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=30
# Distinct clients tracked by the in-process limiter (oldest evicted first).
RATE_LIMIT_MAX_CLIENTS=10000
# Reverse proxies in front of the API that append to X-Forwarded-For
# (e.g. 1 on Railway/Render/Fly or behind a single nginx). 0 = ignore the
# header and use the TCP peer address. Never set higher than the real count.
TRUST_PROXY_HOPS=0
# Comma-separated browser origins allowed to call the API directly. Empty =
# no cross-origin access (the Streamlit UI calls the API server-side).
# Example: CORS_ALLOW_ORIGINS=http://localhost:3000
CORS_ALLOW_ORIGINS=
# Optional shared secret. When set, POST /chat requires `X-API-Key: <key>` (or
# `Authorization: Bearer <key>`) and /health returns details only with it. The
# Streamlit UI sends the same API_KEY. Leave empty for an open public demo.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Show model/provider/config in /health without the key (off by default).
HEALTH_DETAILS_PUBLIC=false
